rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isUnityUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@unity3d[.]com$');
    }

    match /genres/{genreId} {
      allow read: if isUnityUser();
      allow write: if isUnityUser();
    }

    match /snapshots/{snapshotId} {
      allow read: if isUnityUser();
      allow write: if false;

      match /apps/{appId} {
        allow read: if isUnityUser();
        allow write: if false;
      }
    }

    // Pre-pivoted dashboard read model. Written server-side (admin SDK bypasses rules).
    match /genreAggregates/{aggId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    match /fetchLogs/{logId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    match /appComments/{commentId} {
      allow read: if isUnityUser();
      allow write: if isUnityUser();
    }

    match /appNames/{appId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    match /favorites/{favId} {
      allow read: if isUnityUser();
      allow create: if isUnityUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if isUnityUser() && resource.data.userId == request.auth.uid;
    }

    match /savedViews/{viewId} {
      allow read: if resource.data.visibility == 'anyone'
        || (isUnityUser() && (
          resource.data.ownerId == request.auth.uid
          || ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith)
        ));
      allow create: if false;
      allow update: if false;
      allow delete: if isUnityUser() && resource.data.ownerId == request.auth.uid;
    }

    match /insights/{docId} {
      allow read: if isUnityUser();
      allow write: if false;

      match /scores/{scoreId} {
        allow read: if isUnityUser();
        allow write: if false;
      }
    }

    // Cross-genre synthesis (one doc per granularity). Written server-side.
    match /crossGenreInsights/{docId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    match /creativeSnapshots/{snapshotId} {
      allow read: if isUnityUser();
      allow write: if false;

      match /creatives/{docId} {
        allow read: if isUnityUser();
        allow write: if false;
      }
    }

    match /creativeLatest/{docId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    match /creativeInsights/{docId} {
      allow read: if isUnityUser();
      allow write: if false;

      match /scores/{scoreId} {
        allow read: if isUnityUser();
        allow write: if false;
      }
    }

    match /watchlist/{docId} {
      allow read, write: if isUnityUser();
    }

    // Game workspaces: focused game + curated competitor set. Team-shared.
    match /gameWorkspaces/{workspaceId} {
      allow read, write: if isUnityUser();
    }

    // App+week creative fetch cache markers. Written server-side.
    match /appCreativeWeeks/{markerId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    // Cross-genre Market Pulse (one doc per week). Written server-side.
    match /marketPulse/{week} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    // AppBird ownership-transfers feed (one doc per transfer). Written server-side.
    match /ownershipTransfers/{transferId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    // AppBird app-details cache (one doc per store id). Server-only: clients read
    // it through the `appbird/app` route, never directly.
    match /appbirdApps/{appDocId} {
      allow read, write: if false;
    }

    // AppBird X-Ray SDK teardowns: one doc per app, with normalized SDK facets
    // and store popularity. Read model for the /sdks page. Written server-side.
    match /xrayReports/{reportDocId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    // Precomputed SDK / mediator / engine leaderboards (single `latest` doc).
    match /xrayFacets/{docId} {
      allow read: if isUnityUser();
      allow write: if false;
    }

    // Full X-Ray teardown bodies. Server-only: clients read them through the
    // `xray/report` route so a stale report id triggers a refetch.
    match /xrayTeardowns/{teardownDocId} {
      allow read, write: if false;
    }

    // Cached "which apps ship this integration" membership. Server-only: clients go
    // through the `xray/integrationApps` route, which decides whether the cached set
    // is still current and tops it up incrementally when it isn't.
    match /xrayIntegrationApps/{integrationDocId} {
      allow read, write: if false;
    }
  }
}
